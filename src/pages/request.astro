---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
const base = import.meta.env.BASE_URL;
const pages = ["Home", "Plan a visit", "Watch / sermon notes", "Events", "Kids", "Students", "Life Groups", "Women's Ministry", "Garden Outreach", "About / beliefs", "Give", "Contact", "Something new"];
---
<Layout title="Request a change" description="Ask for a change to the Canyon Springs website.">
  <PageHead title="Request a website change" lead="Spot something out of date, or need something new? Tell us here. A person (sometimes with AI's help) makes the change, and you'll get an email when it's live." />

  <section class="wrap section-tight split">
    <aside class="stack small muted">
      <h2 class="h-sm">You don't need this form for</h2>
      <ul>
        <li><strong>Sermons:</strong> upload to YouTube as usual.</li>
        <li><strong>Sermon notes:</strong> attach the Word file below, or drop it in the shared folder.</li>
        <li><strong>Events:</strong> add them to the Church Center calendar.</li>
      </ul>
      <p>Those show up on the site by themselves.</p>
    </aside>

    <form class="req" id="req" novalidate>
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required aria-describedby="email-hint" />
        <p class="hint" id="email-hint">We'll email you when the change is live.</p>
      </div>
      <div class="field">
        <label for="page">Which page?</label>
        <select id="page" name="page">{pages.map((p) => <option>{p}</option>)}</select>
      </div>
      <div class="field">
        <label for="what">What should change?</label>
        <textarea id="what" name="what" rows="6" required placeholder="For example: the Women's retreat moved to March 14."></textarea>
      </div>
      <div class="field">
        <label for="file">Attach a file (optional)</label>
        <input id="file" name="file" type="file" accept=".docx,.pdf,.jpg,.jpeg,.png" aria-describedby="file-hint" />
        <p class="hint" id="file-hint">Photos, a flyer, or sermon notes as a Word file.</p>
      </div>
      <p class="error" id="err" role="alert" hidden>Please fill in your name, a valid email, and what should change.</p>
      <button class="btn" type="submit">Send request</button>
      <p class="hint mock">Mockup: this form doesn't send anything yet.</p>
    </form>

    <div class="done" id="done" hidden tabindex="-1">
      <h2>Thanks, got it.</h2>
      <p>You'll get an email when the change is live,.</p>
      <p><a href={base}>Back to the home page</a></p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("req") as HTMLFormElement;
  const err = document.getElementById("err")!;
  const done = document.getElementById("done")!;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const bad = [...form.querySelectorAll<HTMLInputElement>("[required]")].filter((el) => !el.checkValidity() || !el.value.trim());
    form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
    if (bad.length) {
      bad.forEach((el) => el.setAttribute("aria-invalid", "true"));
      err.hidden = false;
      bad[0].focus();
      return;
    }
    form.hidden = true;
    done.hidden = false;
    done.focus();
  });
</script>

<style>
  .h-sm { font-size: var(--step-1); margin-bottom: 0.5rem; }
  aside ul { padding-left: 1.1em; margin: 0 0 1rem; }
  aside li { margin-bottom: 0.4rem; }
  .req { display: grid; gap: 1.25rem; max-width: 36rem; }
  .field { display: grid; gap: 0.4rem; }
  label { font-weight: 700; font-stretch: 112%; }
  input, select, textarea { font: inherit; color: var(--ink); background: white; border: 1.5px solid oklch(0.7 0.02 256); border-radius: var(--radius); padding: 0.7rem 0.85rem; min-height: 3rem; width: 100%; transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease); }
  input[type="file"] { padding: 0.6rem; }
  input:hover, select:hover, textarea:hover { border-color: var(--ink-2); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; border-color: var(--cobalt); box-shadow: 0 0 0 3px oklch(0.43 0.17 256 / 0.25); }
  textarea::placeholder { color: var(--ink-2); }
  [aria-invalid="true"] { border-color: oklch(0.5 0.19 27); }
  .hint { font-size: var(--step--1); color: var(--ink-2); margin: 0; }
  .error { color: oklch(0.45 0.18 27); font-weight: 600; margin: 0; }
  .req .btn { justify-self: start; }
  .done { max-width: 36rem; }
  .done:focus { outline: none; }
  .done h2 { font-size: var(--step-3); margin-bottom: 1rem; }
</style>
