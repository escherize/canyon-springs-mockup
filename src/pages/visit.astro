---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import { church } from "../data/site";
const base = import.meta.env.BASE_URL;
---
<Layout title="Plan your visit" description="Sundays at 9:00 and 10:30 AM at 1444 Cornell Street, Middleton. Kids programs at both services.">
  <PageHead title="We can't wait to meet you" lead="Join us in person on Sunday at 9:00 or 10:30 AM. Here's everything you need for your first visit." />

  <section class="wrap section-tight split">
    <div class="stack">
      <h2 class="h-sm">When and where</h2>
      <dl class="facts">
        <div><dt>Sundays</dt><dd>9:00 & 10:30 AM. Worship and teaching at both.</dd></div>
        <div><dt>Kids</dt><dd>Newborn–5th grade, at both services. <a href={`${base}kids/`}>About Canyon Kids</a></dd></div>
        <div><dt>Students</dt><dd>6th–12th grade: Sundays at 10:30 AM, and Wednesdays 6:30–8:30 PM for games, dinner, a lesson and small groups.</dd></div>
        <div><dt>Address</dt><dd>{church.street}<br />{church.city}<br /><a href={church.mapUrl} rel="noopener">Get directions</a></dd></div>
        <div><dt>Can't make it?</dt><dd>The 10:30 service streams live. <a href={`${base}watch/`}>Watch online</a></dd></div>
      </dl>
    </div>
    <figure class="arrive">
      <img src={`${base}photos/building.jpg`} width="1600" height="780" alt="The front entrance of Canyon Springs Christian Church: a peaked roof, stone pillars, glass doors and a cross on the tower." />
      <figcaption class="small muted">Look for this entrance at 1444 Cornell Street.</figcaption>
    </figure>
  </section>

  <section class="section expect">
    <div class="wrap">
      <h2>What to expect</h2>
      <div class="expect-grid">
        <div>
          <h3>Family friendly</h3>
          <p>Jesus loves your whole family and so do we. You will find age-appropriate classes designed to help you all deepen your relationship with Jesus.</p>
        </div>
        <div>
          <h3>Warm and welcoming</h3>
          <p>Everyone is welcome! You can expect to be greeted with kindness and a warm smile. Come as you are and have a seat at the table.</p>
        </div>
        <div>
          <h3>Lovingly challenging</h3>
          <p>Each of us has next steps in our faith journey. We will not compromise on guiding everyone to Scripture as we challenge you to become more like Christ.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <div>
      <h2>Bringing kids?</h2>
      <p class="muted">Here's how check-in works on your first Sunday.</p>
    </div>
    <ol class="steps">
      <li><strong>Stop at the front desk.</strong> Someone will take your names, your children's names and birthdates, and your contact info. This registers them so you can check in.</li>
      <li><strong>Check in at the hallway computers.</strong> Enter your phone number, pick your kids, and tap done. A label prints for each child, plus a parent tag for you.</li>
      <li><strong>Drop off up to ten minutes early.</strong> Classes open once two teachers are in the room.</li>
      <li><strong>Keep your parent tag.</strong> You'll need the matching tag at pickup. If your child needs you during the service, their code shows on the screen.</li>
    </ol>
  </section>

  <section class="on-dark section-tight">
    <div class="wrap closing">
      <h2>Questions before Sunday?</h2>
      <p>Call <a href={church.phoneHref}>{church.phone}</a> or email <a href={`mailto:${church.email}`}>{church.email}</a>.</p>
      <div class="btn-row"><a class="btn" href={church.mapUrl} rel="noopener">Get directions</a><a class="btn ghost" href={`${base}about/#beliefs`}>What we believe</a></div>
    </div>
  </section>
</Layout>

<style>
  .h-sm { font-size: var(--step-2); }
  .arrive { margin: 0; }
  .arrive img { border-radius: var(--radius); width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .arrive figcaption { margin-top: 0.6rem; }
  .expect { background: var(--tan-wash); }
  .expect h2 { margin-bottom: 2rem; }
  .expect-grid { display: grid; gap: 2rem clamp(2rem, 4vw, 4rem); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .expect h3 { color: var(--olive); margin-bottom: 0.6rem; }
  .expect p { color: var(--ink-2); }
  .steps { counter-reset: s; list-style: none; padding: 0; margin: 0; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 2.75rem 1fr; gap: 0 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .steps li:first-child { border-top: 2px solid var(--ink); }
  .steps li::before { content: counter(s); grid-row: span 2; font-weight: 850; font-family: var(--display); font-size: var(--step-2); color: var(--olive); line-height: 1; }
  .steps strong { display: block; }
  .closing h2 { font-size: var(--step-3); margin-bottom: 1rem; }
</style>
